; Converts HTML to Hiccup-style data. Ported from the markup->janet function
; of Lemongrass (https://github.com/pyrmont/lemongrass).

(defn- tag-name [x]
  (keyword (string/ascii-lower x)))

(defn- close-tag [x]
  {:close (tag-name x)})

(defn- special-name [prefix]
  (fn [x] (keyword prefix (string/ascii-lower x))))

(defn- tag-attrs [& kvs]
  (apply table kvs))

; Each match returns one node followed by the position after it. An opening tag
; is an array of its name, an optional attribute table and, for a declaration,
; a processing instruction or a self-closing tag, a final `true`. A closing tag
; is a map with the key :close, a comment is nil and text is a string.
(def- grammar
  (peg/compile
    `{:main (* (+ :tag-open :tag-close :cmnt :decl :inst :text) ($))
      :name '(* :a (any (+ :w (set ":-"))))
      :tag-open (group (* "<"
                          :s*
                          (/ :name ~tag-name)
                          (? (/ (some (* :s+ :tag-attr)) ~tag-attrs))
                          :s*
                          (? (* "/" (constant true)))
                          ">"))
      :tag-close (* "</" :s* (/ :name ~close-tag) :s* ">")
      :tag-attr (* (/ :name ~tag-name)
                   "="
                   (+ (* "\"" '(to "\"") "\"")
                      (* "'" '(to "'") "'")
                      '(some (+ :w (set "/:_.")))))
      :cmnt (* "<!--" (thru "-->") (constant nil))
      :decl (group (* "<!"
                      (/ :name ~(special-name "!"))
                      :s*
                      '(to ">")
                      ">"
                      (constant true)))
      :inst (group (* "<?"
                      (/ :name ~(special-name "?"))
                      (? (/ (some (* :s+ :tag-attr)) ~tag-attrs))
                      "?>"
                      (constant true)))
      ; Text is tried last, so a `<` that does not begin a tag, comment,
      ; declaration or instruction is text, as is every `>`.
      :text '(* 1 (to (+ "<" -1)))}))

(def- void-elements
  [:area :base :basefont :bgsound :br :col :command :embed :frame :hr :image
   :img :input :keygen :link :meta :param :source :track :wbr])

(defn- void?
  """
  Checks if an element is void

  An element is void if its final item is `true` or if `html?` is true and its
  name is one of the HTML void elements. This function removes the final `true`
  from the element if it is present.
  """
  [el html?]
  (def end (dec (length el)))
  (if (true? (get el end))
    (do
      (array/remove! el end)
      true)
    (and html? (has-value? void-elements (first el)))))

(defn markup->data
  """
  Converts a string of markup to a Hiccup-style data structure

  Each element is an array of its name as a keyword, an optional table of
  attributes and its children. By default, the string is assumed to be HTML.
  If not, `:html?` can be set to false.
  """
  [s & {:keys [html?] :or {html? true}}]
  (def res ![])
  (def path ![])
  (var curr-node res)
  (var curr-name nil)
  (var in-pre false)
  (var pos 0)
  (while (< pos (length s))
    (def [val next-pos] (peg/match grammar s pos))
    (when (= pos next-pos)
      (def start (max 0 (- pos 5)))
      (def end (min (length s) (+ pos 5)))
      (error (string "cannot parse around '" (string/slice s start end) "'")))
    (set pos next-pos)
    (case (type val)
      :string
      (cond
        in-pre
        (array/push! curr-node val)
        (= " " val)
        (array/push! curr-node val)
        (string/check-set " \n\r\t\v" val)
        nil ; Discard whitespace between elements.
        (array/push! curr-node val))
      :map
      (let [name (get val :close)]
        (if (= curr-name name)
          (do
            (when (= :pre curr-name) (set in-pre false))
            (array/pop! path)
            (set curr-node (get-in res path))
            (set curr-name (first curr-node)))
          (error (string "closing tag </" name "> doesn't match opening tag <" curr-name ">"))))
      :array
      (let [name (first val)]
        (array/push! curr-node val)
        (unless (void? val html?)
          (when (= :pre name) (set in-pre true))
          (array/push! path (dec (length curr-node)))
          (set curr-name name)
          (set curr-node val)))
      :nil
      nil))
  (if (one? (length res))
    (first res)
    res))
