; Set the version of Sled in info.edn and the Predoc man page sources,
; regenerate the man pages with predoc and update CHANGELOG.md. Run from
; anywhere with `wattle res/tools/version.wattle <version>`, using DEVEL
; between releases.

(def- paths
  ["info.edn"
   "man/man1"])

(defn- dirname [path]
  (def i (last (string/find-all "/" path)))
  (if i (string/slice path 0 i) "."))

(defn- update-edn
  [path new-ver]
  (def contents (slurp path))
  (def curr-ver (first (peg/match `(* (thru ":version \"") '(to "\""))
                                  contents)))
  (if (nil? curr-ver)
    (error (string path " missing version line")))
  (def curr-line (string ":version \"" curr-ver "\""))
  (def new-line (string ":version \"" new-ver "\""))
  (def updated (string/replace curr-line new-line contents))
  (spit path updated)
  (print "updated " path " to version " new-ver))

(defn- update-predoc
  [path new-ver]
  (def contents (slurp path))
  (def curr-ver (first (peg/match `(* (thru "Version: ") '(to "\n")) contents)))
  (if (nil? curr-ver)
    (error (string path " missing version line")))
  (def curr-line (string "Version: " curr-ver))
  (def new-line (string "Version: " new-ver))
  (def updated (string/replace curr-line new-line contents))
  (spit path updated)
  (print "updated " path " to version " new-ver))

(defn- today []
  (def d (os/date (os/time) true))
  (string/format "%d-%02d-%02d" (d :year) (inc (d :month)) (inc (d :month-day))))

(defn- changelog
  "Returns the text of CHANGELOG.md for new-ver. A release number replaces the
  Unreleased heading with the number and the date. DEVEL adds an empty
  Unreleased section above the most recent release, if there is none."
  [text new-ver]
  (if (= "DEVEL" new-ver)
    (if (string/find "\n## Unreleased\n" text)
      text
      (let [at (string/find "\n## " text)]
        (unless at
          (error "CHANGELOG.md has no '## ' heading to add Unreleased above"))
        (string (string/slice text 0 (inc at)) "## Unreleased\n\n"
                (string/slice text (inc at)))))
    (do
      (unless (string/find "\n## Unreleased\n" text)
        (error "CHANGELOG.md has no Unreleased section"))
      (string/replace "\n## Unreleased\n"
                      (string "\n## " new-ver " (" (today) ")\n")
                      text))))

(defn- update-changelog
  [path new-ver]
  (spit path (changelog (slurp path) new-ver))
  (print "updated " path " for version " new-ver))

(defn- generate-manpage
  [path]
  (def dest (string/slice path 0 -8))
  (print "converting " path " to " dest)
  (os/execute ["predoc" path "-o" dest] :px))

(defn main
  [script version & args]
  (def root (-> (dyn :current-file) os/realpath dirname dirname dirname))
  ; check the changelog first so that nothing is written if it cannot be updated
  (def changelog-path (string root "/CHANGELOG.md"))
  (changelog (slurp changelog-path) version)
  (def to-update (map #(string root "/" $) paths))
  (def predocs ![])
  (each path to-update
    (if (= :directory (os/stat path :mode))
      (array/concat! to-update (map #(string path "/" $) (os/dir path)))
      (cond
        (string/has-suffix? ".edn" path)
        (update-edn path version)
        (string/has-suffix? ".predoc" path)
        (do
          (update-predoc path version)
          (array/push! predocs path)))))
  (update-changelog changelog-path version)
  (each path predocs
    (generate-manpage path)))
