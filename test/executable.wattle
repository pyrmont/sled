(import ../deps/gum/test :prefix "")

; These tests run the executable that `wattle build exe` writes, so build it
; first and run from the project root.
(def- exe "zig-out/bin/sled")

(unless (= :file (os/stat exe :mode))
  (error (string "cannot find " exe " (run `wattle build exe` from the project root)")))

(def- home
  (string (or (os/getenv "TMPDIR") "/tmp") "/sled-test-home-" (os/getpid)))

; Each run has an empty home directory, so no real session file is read.
; Standard input is /dev/null, so sled does not ask for a cookie when the
; tests run in a terminal.
(defn- run [& args]
  (with [null (file/open "/dev/null" :r)]
    (def env {"HOME" home "PATH" (os/getenv "PATH")
              :in null :out :pipe :err :pipe})
    (def proc (os/spawn [exe |args] :pe env))
    (def out (:read (proc :out) :all))
    (def err (:read (proc :err) :all))
    [(os/proc-wait proc) out err]))

(deftest cli-no-args
  (def [exit-code out err] (run))
  (def msg
    """
    sled: no subcommand provided
    Try 'sled --help' for more information.
    """)
  (is (= 1 exit-code))
  (is (= nil out))
  (is (== (string msg "\n") err)))

(deftest cli-bad-option
  (def [exit-code out err] (run "--bad-option"))
  (def msg
    """
    sled: unrecognized option '--bad-option'
    Try 'sled --help' for more information.
    """)
  (is (= 1 exit-code))
  (is (= nil out))
  (is (== (string msg "\n") err)))

(deftest cli-help
  (def [exit-code out err] (run "--help"))
  (def msg
    """
    Usage: sled [--session <file>] <subcommand> [<args>]

    Seasonal Linear Enigma Device, a command-line utility for Advent of Code.

    Options:

     -s, --session <file>    A file that contains the session ID for the user's logged in session. (Default:
                             ~/.config/sled/session.txt)
     -v, --version           Show version information.
     -h, --help              Show this help message.

    Subcommands:

     a, answer      Submit an answer.
     c, calendar    Display the calendar.
     p, puzzle      Download a puzzle.

    For more information on each subcommand, type 'sled help <subcommand>'.
    """)
  (is (= 0 exit-code))
  (is (== (string msg "\n") out))
  (is (= nil err)))

(defn- git-describe []
  (def [ok? proc] (protect (os/spawn ["git" "describe" "--always" "--dirty"
                                      "--abbrev=7" "--match=NONE"]
                                     :p {:out :pipe :err :pipe})))
  (when ok?
    (def out (:read (proc :out) :all))
    (:read (proc :err) :all)
    (when (and (zero? (os/proc-wait proc)) out)
      (string/trim out))))

; The label that `wattle build exe` derives from :version in info.edn.
(defn- expected-version []
  (def version (get (first (parse-all (slurp "info.edn"))) :version))
  (if (= "DEVEL" version)
    (if-let [described (git-describe)]
      (string "DEVEL-" described)
      "DEVEL")
    version))

(deftest cli-version
  (def expect (expected-version))
  (each flag ["--version" "-v"]
    (def [exit-code out err] (run flag))
    (is (= 0 exit-code))
    (is (== (string expect "\n") out))
    (is (= nil err))))

(deftest cli-version-before-subcommand
  (def [exit-code out _] (run "--version" "calendar"))
  (is (= 0 exit-code))
  (is (not (nil? out))))

(deftest cli-bad-part
  (def [exit-code out err] (run "--session" "LICENSE" "answer" "--part" "3" "42"))
  (is (= 1 exit-code))
  (is (= nil out))
  (is (== "error: part must be 1 or 2\n" err)))

(deftest cli-missing-session
  (def [exit-code out err] (run "--session" "nonexistent.txt" "calendar"))
  (is (= 1 exit-code))
  (is (= nil out))
  (is (== "error: no file 'nonexistent.txt'\n" err)))

(deftest cli-does-not-read-session-in-current-directory
  ; The project root has a session.txt, which is read only with --session.
  (def [exit-code out err] (run "calendar"))
  (is (= 1 exit-code))
  (is (= nil out))
  (is (== (string "error: no session cookie at " home "/.config/sled/session.txt"
                  "; run sled in a terminal to enter one, or use --session\n")
          err))
  (is (nil? (os/stat (string home "/.config") :mode))))

(os/mkdir home)
(defer (os/rmdir home)
  (run-tests!))
