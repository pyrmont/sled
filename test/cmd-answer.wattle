(import ../deps/gum/test :prefix "")

(def- env (require "../lib/cmd-answer"))
(def- parse-response (get-in env ['parse-response :value]))

(defn- plain
  "Removes ANSI colour codes, which are added when stdout is a terminal"
  [s]
  (string (peg/replace-all `(* "\e[" (to "m") "m") "" s)))

(deftest parse-response-correct
  (def result (parse-response "That's the right answer! You are one star closer"))
  (is (= :correct (result :result)))
  (is (= "Your answer is correct!" (plain (result :message)))))

(deftest parse-response-incorrect-too-low
  (def result (parse-response "That's not the right answer; your answer is too low"))
  (is (= :incorrect (result :result)))
  (is (= "Your answer is incorrect. It is too low." (plain (result :message)))))

(deftest parse-response-incorrect-too-high
  (def result (parse-response "That's not the right answer; your answer is too high"))
  (is (= :incorrect (result :result)))
  (is (= "Your answer is incorrect. It is too high." (plain (result :message)))))

(deftest parse-response-incorrect-generic
  (def result (parse-response "That's not the right answer"))
  (is (= :incorrect (result :result)))
  (is (= "Your answer is incorrect." (plain (result :message)))))

(deftest parse-response-rate-limited
  (def result (parse-response "You gave an answer too recently"))
  (is (= :rate-limited (result :result)))
  (is (= "You gave an answer too recently. Please try again later." (result :message))))

(deftest parse-response-already-solved
  (def result (parse-response "You don't seem to be solving the right level"))
  (is (= :already-solved (result :result)))
  (is (= "You've already completed this puzzle." (result :message))))

(deftest parse-response-unknown
  (def result (parse-response "Some unexpected response"))
  (is (= :unknown (result :result)))
  (is (= "Unable to parse response. Try submitting manually." (result :message))))

(run-tests!)
